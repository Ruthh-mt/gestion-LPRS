<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.15" maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.professeur.DemandeCreateController">
    <items>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
            <children>
                <Button alignment="CENTER" maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onProfilClick" prefHeight="25.0" text="Profil" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="650.0" />
                <Button alignment="CENTER" maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onRetourClick" prefHeight="25.0" text="Retour" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="680.0" />
                <Separator layoutX="59.0" layoutY="632.0" prefWidth="200.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="540.0" />
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onDemanderClick" prefHeight="25.0" text="Demander" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="30.0" />
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onAnnulerClick" prefHeight="25.0" text="Annuler" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0" />
            </children>
        </AnchorPane>
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0" style="-fx-background-color: #DDDDDD;">
            <children>
                <Label alignment="CENTER" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" text="DEMANDES DE FOURNITURES" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <font>
                        <Font name="Consolas Bold" size="36.0" />
                    </font>
                </Label>
                <Separator AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="90.0" />
                <TableView fx:id="demandeTable" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="110.0" AnchorPane.bottomAnchor="20.0">
                    <columns>
                        <TableColumn fx:id="numCol"        maxWidth="80.0"  minWidth="80.0"  prefWidth="80.0"  resizable="false" text="N°" />
                        <TableColumn fx:id="fournitureCol" maxWidth="750.0" minWidth="100.0" prefWidth="750.0" resizable="false" text="Fourniture" />
                        <TableColumn fx:id="quantiteCol"   maxWidth="200.0" minWidth="200.0" prefWidth="200.0" resizable="false" text="Quantité" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </AnchorPane>
    </items>
</SplitPane>
