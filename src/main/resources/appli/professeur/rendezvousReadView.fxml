<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.15" maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.professeur.RendezvousReadController">
    <items>

        <AnchorPane minHeight="0.0" minWidth="0.0">
            <children>
                <!-- Remplace ce bloc dans la sidebar -->

                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onModifierRdvClick" prefHeight="25.0" text="Modifier le RDV" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="30.0" />
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onAnnulerRdvClick" prefHeight="25.0" text="Annuler le RDV" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0" />
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onSupprimerRdvClick" prefHeight="25.0" text="Supprimer le RDV" style="-fx-text-fill: red;" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="90.0" />

                <Separator AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="540.0" />

                <Button alignment="CENTER" maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onProfilClick" prefHeight="25.0" text="Profil" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="650.0" />
                <Button alignment="CENTER" maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onRetourClick" prefHeight="25.0" text="Retour au planning" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="680.0" />
            </children>
        </AnchorPane>

        <AnchorPane minHeight="0.0" minWidth="0.0" style="-fx-background-color: #EEEEEE;">
            <children>

                <Label alignment="CENTER" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" text="DÉTAILS DU RENDEZ-VOUS" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <font>
                        <Font name="Consolas Bold" size="30.0" />
                    </font>
                </Label>

                <Separator AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="80.0" />

                <Label text="Date :" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="130.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="dateLabel" text="—" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="130.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <Label text="Heure :" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="190.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="heureLabel" text="—" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="190.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <Label text="Statut :" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="250.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="statusLabel" text="—" AnchorPane.leftAnchor="300.0" AnchorPane.topAnchor="250.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <Label text="Salle :" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="310.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="salleLabel" text="—" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="310.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <Label text="Dossier :" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="370.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="dossierLabel" text="—" AnchorPane.leftAnchor="300.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="370.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

            </children>
        </AnchorPane>

    </items>
</SplitPane>