<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.15" maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.profil.ProfilReadController">
    <items>

        <!-- Menu latéral gauche -->
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
            <children>
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onModifierProfilClick" prefHeight="25.0" text="Modifier le profil" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="30.0" />

                <Separator AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="540.0" />

                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onRetourClick" prefHeight="25.0" text="Retour" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="680.0" />
            </children>
        </AnchorPane>

        <!-- Contenu principal -->
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0" style="-fx-background-color: #DDDDDD;">
            <children>

                <!-- Titre -->
                <Label alignment="CENTER" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" text="MON PROFIL" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <font><Font name="Consolas Bold" size="36.0" /></font>
                </Label>

                <Separator AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="90.0" />

                <!-- Nom -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Nom :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="100.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="nomLabel" text="—" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <!-- Prénom -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Prénom :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="150.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="prenomLabel" text="—" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="150.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <!-- Email -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Email :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="200.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="emailLabel" text="—" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="200.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

                <!-- Rôle -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Rôle :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="250.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="roleLabel" text="—" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="250.0">
                    <font><Font name="Consolas" size="18.0" /></font>
                </Label>

            </children>
        </AnchorPane>

    </items>
</SplitPane>
