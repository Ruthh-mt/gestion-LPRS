<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.15" maxHeight="720.0" maxWidth="1280.0" minHeight="720.0" minWidth="1280.0" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.profil.profilUpdateController">
    <items>

        <!-- Menu latéral gauche -->
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
            <children>
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onEnregistrerClick" prefHeight="25.0" text="Enregistrer" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="30.0" />
                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onAnnulerClick" prefHeight="25.0" text="Annuler" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="60.0" />

                <Separator AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="540.0" />

                <Button maxHeight="25.0" minHeight="25.0" mnemonicParsing="false" onAction="#onAnnulerClick" prefHeight="25.0" text="Retour" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="650.0" />
            </children>
        </AnchorPane>

        <!-- Contenu principal -->
        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0" style="-fx-background-color: #DDDDDD;">
            <children>

                <!-- Titre -->
                <Label alignment="CENTER" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" text="MODIFIER MON PROFIL" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                    <font><Font name="Consolas Bold" size="36.0" /></font>
                </Label>

                <Separator AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="90.0" />

                <!-- Nom -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Nom :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="100.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <TextField fx:id="nomField" layoutX="257.0" layoutY="96.0" maxHeight="25.0" minHeight="25.0" prefHeight="25.0" promptText="Votre nom" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
               <font>
                  <Font name="Consolas" size="14.0" />
               </font></TextField>

                <!-- Prénom -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Prénom :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="150.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <TextField fx:id="prenomField" maxHeight="25.0" minHeight="25.0" prefHeight="25.0" promptText="Votre prénom" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="150.0">
               <font>
                  <Font size="14.0" />
               </font></TextField>

                <!-- Email -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Email :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="200.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <TextField fx:id="emailField" maxHeight="25.0" minHeight="25.0" prefHeight="25.0" promptText="Votre email" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="200.0">
               <font>
                  <Font size="14.0" />
               </font></TextField>

                <!-- Rôle (lecture seule) -->
                <Label maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="Rôle :" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="900.0" AnchorPane.topAnchor="250.0">
                    <font><Font name="Consolas Bold" size="18.0" /></font>
                </Label>
                <Label fx:id="roleLabel" maxHeight="25.0" minHeight="25.0" prefHeight="25.0" text="—" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="250.0">
                    <font><Font name="Consolas" size="14.0" /></font>
                </Label>

                <!-- Erreur -->
                <Label fx:id="erreurLabel" style="-fx-text-fill: red;" text="" AnchorPane.leftAnchor="100.0" AnchorPane.topAnchor="385.0">
                    <font><Font name="Consolas" size="13.0" /></font>
                </Label>

            </children>
        </AnchorPane>

    </items>
</SplitPane>
