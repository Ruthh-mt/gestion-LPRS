<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="573.0" prefWidth="958.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.gestionnaire.AccueilGestionnaireController">
   <top>
      <Label contentDisplay="CENTER" text="Control Center" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="498.0" prefWidth="172.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="STATS GLOBAL">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Label fx:id="demandeEnCours" prefHeight="70.0" prefWidth="164.0" text="[insert num]Demande en cours" textAlignment="RIGHT" textOverrun="CLIP" />
            <Label fx:id="commandeEnCours" prefHeight="70.0" prefWidth="164.0" text="[insert num]Commande en cours" />
            <Label fx:id="nbFournitureVide" prefHeight="70.0" prefWidth="164.0" text="[insert num]Fourniture bientot fini" textAlignment="CENTER" />
         </children>
      </VBox>
   </left>
   <bottom>
      <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <items>
            <MenuButton mnemonicParsing="false" text="Mon compte">
              <items>
                <MenuItem mnemonicParsing="false" text="Profil" />
                <MenuItem mnemonicParsing="false" text="Deconnexion" />
              </items>
            </MenuButton>
            <Button mnemonicParsing="false" onAction="#onRetourHomePage" text="Retour à l'accueil" />
        </items>
      </ToolBar>
   </bottom>
   <center>
      <TabPane prefHeight="486.0" prefWidth="778.0" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <Tab onSelectionChanged="#onCommandeChosed" text="Commandes">
               <content>
                  <AnchorPane prefHeight="455.0" prefWidth="641.0">
                     <children>
                        <TableView fx:id="commandeTableView" layoutX="6.0" layoutY="43.0" prefHeight="346.0" prefWidth="445.0" />
                        <Label layoutX="289.0" layoutY="4.0" text="Commandes">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Button layoutX="452.0" layoutY="43.0" mnemonicParsing="false" onAction="#onNewCommand" text="Faire une nouvelle commande " />
                        <ToolBar layoutX="6.0" layoutY="416.0" prefHeight="40.0" prefWidth="574.0">
                          <items>
                              <Button mnemonicParsing="false" onAction="#onShowPastCommand" text="Voir toutes les commandes passées" />
                            <Button mnemonicParsing="false" onAction="#onShowMyCommandes" text="Voir mes commandes" />
                          </items>
                        </ToolBar>
                     </children>
                  </AnchorPane>
               </content>
          </Tab>
            <Tab onSelectionChanged="#onFournitureChosed" text="Fourniture">
               <content>
                  <AnchorPane prefHeight="455.0" prefWidth="641.0">
                     <children>
                        <TableView fx:id="fournitureTableView" layoutX="6.0" layoutY="43.0" prefHeight="346.0" prefWidth="445.0" />
                        <Label layoutX="289.0" layoutY="4.0" text="Fourniture">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Button layoutX="466.0" layoutY="43.0" mnemonicParsing="false" onAction="#onNewFourniture" text="Ajouter une fourniture" />
                        <ToolBar layoutX="2.0" layoutY="424.0" prefHeight="40.0" prefWidth="574.0">
                           <items>
                              <Button mnemonicParsing="false" onAction="#onShowFinishedFourniture" text="Voir les fournitures bientot fini" />
                           </items>
                        </ToolBar>
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
            <Tab onSelectionChanged="#onFournisseurChosed" text="Fournisseur">
               <content>
                  <AnchorPane prefHeight="455.0" prefWidth="641.0">
                     <children>
                        <TableView fx:id="fournisseurTableView" layoutX="6.0" layoutY="43.0" prefHeight="346.0" prefWidth="445.0" />
                        <Label layoutX="289.0" layoutY="4.0" text="Fournisseur">
                           <font>
                              <Font name="System Bold" size="14.0" />
