                              <Button mnemonicParsing="false" onAction="#onShowAllFournisseur" text="Voir tout les fournisseur" />
                          </items>
                        </ToolBar>
                     </children>
                  </AnchorPane>
               </content>
            </Tab>
        </tabs>
      </TabPane>
   </center>
   <right>
      <VBox alignment="TOP_CENTER" prefHeight="70.0" prefWidth="164.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="TOP_CENTER" text="URGENCE" textFill="RED">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </right>
</BorderPane>
