<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="448.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.secretaire.DossierCreateController">
   <children>
      <Label layoutX="90.0" layoutY="25.0" text="Creer un dossier étudiant">
         <font>
            <Font size="32.0" />
         </font>
      </Label>
      <Label layoutX="343.0" layoutY="124.0" text="Ref filière" />
      <Button fx:id="validerButton" layoutX="180.0" layoutY="286.0" mnemonicParsing="false" onAction="#ajouterDossier" text="Valider" />
      <Button fx:id="annulerButton" layoutX="339.0" layoutY="286.0" mnemonicParsing="false" text="Annuler" />
      <Button fx:id="retourButton" layoutX="23.0" layoutY="394.0" mnemonicParsing="false" onAction="#redirectionListeDossier" text="Retour vers la liste des dossiers" />
      <Label layoutX="343.0" layoutY="175.0" text="Ref fiche " />
      <Label fx:id="sessionLabel" layoutX="485.0" layoutY="64.0" text="sessionLabel" />
      <ComboBox fx:id="refFicheTextfield" layoutX="424.0" layoutY="171.0" prefWidth="150.0" />
      <ComboBox fx:id="refFiliereTextfield" layoutX="424.0" layoutY="120.0" prefWidth="150.0" />
      <Label fx:id="erreurLabel" layoutX="247.0" layoutY="351.0" text="erreurLabel" />
      <VBox layoutX="23.0" layoutY="119.0" prefHeight="114.0" prefWidth="66.0" spacing="30.0">
         <children>
            <Label text="Date" />
            <Label text="Heure " />
            <Label text="Motivation " />
         </children>
      </VBox>
      <VBox layoutX="100.0" layoutY="114.0" prefHeight="138.0" prefWidth="159.0" spacing="25.0">
         <children>
            <DatePicker fx:id="dateTextField" />
            <Spinner fx:id="heureTextfield" />
            <TextArea fx:id="motivationTextfield" prefHeight="47.0" prefWidth="239.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
