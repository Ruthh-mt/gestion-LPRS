<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.secretaire.DossierListController">
   <children>
      <TableView fx:id="tableview" layoutX="63.0" layoutY="81.0" prefHeight="237.0" prefWidth="301.0" />
      <Label fx:id="sessionLabel" layoutX="474.0" layoutY="55.0" text="sessionLabel" />
      <Label layoutX="91.0" layoutY="14.0" prefHeight="49.0" prefWidth="308.0" text="Mes dossiers">
         <font>
            <Font size="33.0" />
         </font>
      </Label>
      <Button fx:id="modifierDossierBtn" layoutX="441.0" layoutY="165.0" mnemonicParsing="false" text="Modifier le dossier" />
      <Button fx:id="supprimerDossierBtn" layoutX="441.0" layoutY="228.0" mnemonicParsing="false" text="Supprimer le dossier" />
      <Button fx:id="accueilBtn" layoutX="482.0" layoutY="353.0" mnemonicParsing="false" onAction="#redirectionAccueil" text="Accueil" />
      <Button fx:id="ajouterDossierBtn" layoutX="167.0" layoutY="341.0" mnemonicParsing="false" onAction="#redirectionAjouterDossier" text="Ajouter un dossier" />
   </children>
</AnchorPane>
