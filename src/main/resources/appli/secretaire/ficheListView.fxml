<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="401.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.secretaire.FicheListController">
   <children>
      <Label layoutX="159.0" layoutY="14.0" prefHeight="25.0" prefWidth="381.0" text="Mes fiches">
         <font>
            <Font size="28.0" />
         </font>
      </Label>
      <TableView fx:id="tableView" layoutX="35.0" layoutY="57.0" onMouseClicked="#gestionListe" prefHeight="240.0" prefWidth="455.0" />
      <Button fx:id="redirectionAccueilBtn" layoutX="52.0" layoutY="346.0" mnemonicParsing="false" onAction="#redirectionAccueil" text="Retour vers l'accueil" />
      <Button fx:id="redirectionDossierBtn" layoutX="511.0" layoutY="346.0" mnemonicParsing="false" onAction="#redirectionDossierBtn" text="Voir mes dossiers" />
      <Button fx:id="modiferFicheBtn" layoutX="530.0" layoutY="145.0" mnemonicParsing="false" onAction="#redirectionUpdateFiche" text="Modifier la fiche" />
      <Button fx:id="creerFicheBtn" layoutX="263.0" layoutY="346.0" mnemonicParsing="false" onAction="#redirectionCreateFiche" text="Créer une fiche" />
      <Label layoutX="553.0" layoutY="34.0" />
      <Label fx:id="sessionLabel" layoutX="539.0" layoutY="34.0" text="label session" />
      <Button fx:id="supprimerFicheBtn" layoutX="530.0" layoutY="201.0" mnemonicParsing="false" text="Supprimer la fiche" />
   </children>
</AnchorPane>
