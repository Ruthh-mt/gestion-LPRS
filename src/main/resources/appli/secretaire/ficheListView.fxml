<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="506.0" prefWidth="680.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="appli.secretaire.FicheListController">
   <children>
      <TableView fx:id="tableView" layoutX="26.0" layoutY="111.0" onMouseClicked="#gestionListe" prefHeight="177.0" prefWidth="513.0" />
      <Button fx:id="redirectionAccueilBtn" layoutX="47.0" layoutY="428.0" mnemonicParsing="false" onAction="#redirectionAccueil" text="Retour vers l'accueil" />
      <Button fx:id="redirectionDossierBtn" layoutX="560.0" layoutY="221.0" mnemonicParsing="false" onAction="#redirectionDossierBtn" text="Voir mes dossiers" />
      <Button fx:id="modiferFicheBtn" layoutX="117.0" layoutY="317.0" mnemonicParsing="false" onAction="#redirectionUpdateFiche" text="Modifier la fiche" />
      <Button fx:id="creerFicheBtn" layoutX="566.0" layoutY="159.0" mnemonicParsing="false" onAction="#redirectionCreateFiche" text="Créer une fiche" />
      <Label layoutX="553.0" layoutY="34.0" />
      <Label fx:id="sessionLabel" layoutX="539.0" layoutY="34.0" text="label session" />
      <Button fx:id="supprimerFicheBtn" layoutX="367.0" layoutY="317.0" mnemonicParsing="false" onAction="#supprimerFiche" text="Supprimer la fiche" />
      <Separator layoutX="-22.0" layoutY="93.0" prefHeight="2.0" prefWidth="696.0" />
      <Label layoutX="214.0" layoutY="16.0" prefHeight="69.0" prefWidth="251.0" text="Mes fiches">
